# Copy to .env for local development. Never commit .env.
# Placeholders only: no real secrets belong in this file.

# --- API (Phase 0+) ---
NODE_ENV=development
PORT=3000

# Local Docker Compose PostgreSQL. Unsafe for production.
# Also used by `npm run test:integration`, which creates/uses a separate
# database named workmesh_test on the same server.
DATABASE_URL=postgres://workmesh:workmesh@localhost:5432/workmesh

# --- Operator plane / dashboard (Phase 6+). REQUIRED: the API refuses to start without them. ---
# Two DIFFERENT secrets of at least 16 characters. `viewer` can read everything; `operator` can
# also change things (submit, cancel, retry, enable/disable). The placeholders below work for local
# development only: with NODE_ENV=production the API rejects any value containing "change-me".
# Generate real ones with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
OPERATOR_API_KEY=change-me-operator-key-0001
VIEWER_API_KEY=change-me-viewer-key-00002

# Dashboard dev server only. NOT read from this file: set it in your shell if the API is not on
# localhost:3000, e.g.  VITE_API_PROXY_TARGET=http://other-host:3000 npm run dev:dashboard

# --- Reliability (Phase 3+). Optional: these defaults apply if unset. ---
# How long a claimed job stays owned without renewal before it can be recovered (ms, 1000-3600000).
LEASE_MS=30000
# Retry delay = min(RETRY_MAX_MS, RETRY_BASE_MS * 2^(attempt-1)), with jitter (ms).
RETRY_BASE_MS=1000
RETRY_MAX_MS=300000
# How often each API instance sweeps for expired leases (ms, 100-600000).
REAPER_INTERVAL_MS=5000

# --- Scheduling (Phase 4+). Optional. ---
# How often each API instance checks for recurring schedules that are due (ms, 100-60000).
SCHEDULER_INTERVAL_MS=1000

# --- Sample worker (Phase 2+). Optional: these defaults apply if unset. ---
# Where the worker finds the API.
WORKMESH_API_URL=http://localhost:3000
# Name shown for this worker in the workers table.
WORKER_NAME=sample-worker
# Max handlers this process runs at once.
WORKER_CONCURRENCY=2
# How often an idle worker asks for work, in milliseconds.
WORKER_POLL_MS=1000
# Where the idempotent invoice.generate sample handler writes files (Phase 3+).
INVOICE_DIR=./out/invoices

# --- Scaling and gateway (Phase 7). All optional; the defaults work. ---
# A name for this API instance. If set, every response carries `X-Served-By: <name>`
# (useful to SEE load balancing). The gateway compose file sets api-1 / api-2 itself.
# INSTANCE_ID=api-1
# Which proxies to believe when they say who the client is (X-Forwarded-For). Comma-separated exact
# IPs or CIDRs (e.g. 172.28.57.10 or 10.0.0.0/8). Leave UNSET when the API is not behind a proxy:
# then the header is ignored. `true`, plain numbers and /0 are rejected on purpose.
# TRUST_PROXY=
# On SIGTERM: keep serving as "not ready" for this long, then give in-flight requests this long to finish (ms).
SHUTDOWN_DRAIN_MS=3000
SHUTDOWN_GRACE_MS=20000
# Database connections per API instance (1-100). instances x this must stay below PostgreSQL max_connections.
DB_POOL_MAX=10
# Port the gateway stack publishes on your machine (`npm run gateway:up`).
# GATEWAY_PORT=8080
